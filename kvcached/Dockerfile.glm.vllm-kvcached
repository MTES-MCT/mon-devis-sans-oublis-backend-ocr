FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HF_HOME=/root/.cache/huggingface
ENV TORCH_CUDA_ARCH_LIST="8.9+PTX"
ENV BNB_CUDA_VERSION=121
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

RUN apt-get update && apt-get install -y \
    python3 python3-pip git curl build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

# PyTorch
RUN pip install \
    torch==2.5.1+cu121 \
    torchvision==0.20.1+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# vLLM
RUN pip install vllm==0.12.0

# bitsandbytes (CUDA-aware)
RUN pip install \
    bitsandbytes>=0.46.1

# kvcached
RUN pip install --no-build-isolation \
    git+https://github.com/ovg-project/kvcached.git

ENV ENABLE_KVCACHED=true
ENV KVCACHED_AUTOPATCH=1

ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]