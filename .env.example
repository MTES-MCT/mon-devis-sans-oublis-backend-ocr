# API Authentication
API_KEY=your-secret-api-key-here

# Hugging Face Token (required for downloading models)
HF_TOKEN=your-huggingface-token-here

# Sentry Configuration (optional)
SENTRY_DNS=

# Service Configuration
# Comma-separated list of enabled services
# Available: marker, nanonets, deepseek-ocr, hunyuan-ocr
ENABLED_SERVICES=marker,nanonets,deepseek-ocr,hunyuan-ocr

# VLLM Service Endpoints (Docker internal network)
# These should not need to be changed unless you modify docker-compose
NANONETS_ENDPOINT=http://nanonets-vllm:8000/v1
DEEPSEEK_ENDPOINT=http://deepseek-vllm:8000/v1
HUNYUAN_ENDPOINT=http://hunyuan-vllm:8000/v1

# Concurrency Control
# Maximum number of concurrent OCR requests per service
MAX_CONCURRENT_OCR_REQUESTS=3

# VLLM Health Check Timeout (seconds)
VLLM_HEALTH_TIMEOUT=30

# Server Configuration
WORKERS=1
WORKER_CLASS=uvicorn.workers.UvicornWorker
HOST=0.0.0.0
PORT=80

# Logging
LOG_LEVEL=info
ACCESS_LOG=true

# Resource Limits
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT=120
GRACEFUL_TIMEOUT=30
KEEPALIVE=5